#!/bin/bash
# La app queda a nombre del usuario que ha iniciado sesión (no de root): así las
# actualizaciones automáticas pueden reemplazarla sin pedir la contraseña de administrador.
APP="${THEVOICES_APP:-/Applications/The Voices.app}"
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null)"
if [ -d "$APP" ] && [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    chown -R "$CONSOLE_USER":admin "$APP"
fi
exit 0
